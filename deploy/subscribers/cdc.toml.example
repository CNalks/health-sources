# 公卫前沿（CloudBase）订阅方。复制到 /etc/health-sources/subscribers/cdc.toml（root 0644）。
# 密钥另放 /etc/health-sources/subscribers/cdc.secret（root 0600，KEY=VALUE 每行一个），不进仓库：
#   TENCENTCLOUD_SECRETID=...      # CAM 子用户 hs-push-cdc，策略只允许对 hs-ingest 调用 scf:InvokeFunction
#   TENCENTCLOUD_SECRETKEY=...
#   HS_INGEST_TOKEN=...            # 可选：与 hs-ingest 环境变量 HS_INGEST_TOKEN 相同（纵深防御）
transport = "tencent-scf-invoke"
window_days = 400          # 与 by-source 导出相同
batch_size = 100
max_requests_per_run = 20
max_body_bytes = 900000    # 订阅方单次请求体上限 1 MB

[tencent-scf-invoke]
region = "ap-shanghai"
namespace = "cloud1-d2guax8bue7c6cbb7"
function = "hs-ingest"

# A1 备选（HTTP 路由 + HMAC，密钥文件里放 HS_INGEST_SECRET=...）：
# transport = "https-hmac"
# [https-hmac]
# url = "https://<env>.ap-shanghai.app.tcloudbase.com/hs-ingest"
