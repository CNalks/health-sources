# 公卫前沿（CloudBase）订阅方。复制到 /etc/health-sources/subscribers/cdc.toml（root 0644）。
# 密钥另放 /etc/health-sources/subscribers/cdc.secret（root 0600，KEY=VALUE），不进仓库：
#   HS_INGEST_SECRET=...        # 与 CloudBase 云函数 hs-ingest 环境变量 HS_INGEST_SECRET 相同
# 线上（2026-10-25 起）用 A1：HTTP 路由 /hs-ingest + HMAC-SHA256（时间戳 ±300 秒 + 一次性 nonce）。
transport = "https-hmac"
window_days = 400          # 与 by-source 导出相同
batch_size = 100
max_requests_per_run = 40  # 首次全量约 15 次请求
max_body_bytes = 90000     # CloudBase HTTP 访问服务：文本类请求体上限 100KB（EXCEED_MAX_PAYLOAD_SIZE）

[https-hmac]
url = "https://cloud1-d2guax8bue7c6cbb7-1356545629.ap-shanghai.app.tcloudbase.com/hs-ingest"

# A3（CAM 子用户直接 Invoke，未采用）：
# transport = "tencent-scf-invoke"
# [tencent-scf-invoke]
# region = "ap-shanghai"
# namespace = "cloud1-d2guax8bue7c6cbb7"
# function = "hs-ingest"
